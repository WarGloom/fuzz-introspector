diff --git a/infra/base-images/base-builder/Dockerfile b/infra/base-images/base-builder/Dockerfile
index 16b787e67..e6516f622 100644
--- a/infra/base-images/base-builder/Dockerfile
+++ b/infra/base-images/base-builder/Dockerfile
@@ -229,4 +229,27 @@ COPY indexer /opt/indexer
 COPY --from=gcr.io/oss-fuzz-base/indexer /indexer/build/indexer /opt/indexer/indexer
 RUN chmod a+x /opt/indexer/indexer /opt/indexer/index_build.py

+# Copy local fuzz-introspector with our changes
+COPY fuzz-introspector /fuzz-introspector
+
+# Install Rust toolchain
+RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
+    sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
+ENV PATH="/root/.cargo/bin:${PATH}"
+
+# Build native Rust components
+RUN cd /fuzz-introspector/tools/native_debug_correlator_rust && cargo build --release && \
+    cd /fuzz-introspector/tools/native_yaml_loader_rust && cargo build --release && \
+    cd /fuzz-introspector/tools/native_llvm_cov_loader_rust && cargo build --release && \
+    cd /fuzz-introspector/tools/native_analysis_plugins_rust && cargo build --release
+
+# Add native binaries to PATH so fuzz-introspector can find them
+ENV PATH="/fuzz-introspector/tools/native_debug_correlator_rust/target/release:${PATH}"
+ENV PATH="/fuzz-introspector/tools/native_yaml_loader_rust/target/release:${PATH}"
+ENV PATH="/fuzz-introspector/tools/native_llvm_cov_loader_rust/target/release:${PATH}"
+ENV PATH="/fuzz-introspector/tools/native_analysis_plugins_rust/target/release:${PATH}"
+
+# Enable native backends by default inside the OSS-Fuzz image
+ENV FI_NATIVE_BACKENDS=rust
+
 CMD ["compile"]
